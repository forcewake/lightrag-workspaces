@@ -0,0 +1,29 @@
+export type WorkspaceEntry = 'webui' | 'workspace'
+
+/** Preserve the current entry, while dropping the previous corpus's route state. */
+export function workspaceEntryPath(workspaceId: string, pathname: string): string {
+  const entry: WorkspaceEntry = /\/(?:workspace(?:\/|\.html)?)(?:[^/]*)?$/.test(pathname)
+    ? 'workspace'
+    : 'webui'
+  return `/workspaces/${encodeURIComponent(workspaceId)}/${entry}/`
+}
+
+/**
+ * The configured legacy-storage owner retains every pre-gateway browser key. Other corpora never read,
+ * migrate or overwrite those keys, including the old settings envelope that
+ * still owns prompt history and graph labels.
+ */
+export function createWorkspaceStorageKeys(workspaceId?: string, legacyStorageWorkspace = 'default') {
+  const namespace = workspaceId && workspaceId !== legacyStorageWorkspace
+    ? encodeURIComponent(workspaceId)
+    : ''
+  const storageKey = (name: string) => `lightrag:${namespace}:${name}`
+  return {
+    namespace,
+    querySettings: storageKey('query-settings-storage'),
+    webuiHistory: storageKey('webui-retrieval-history'),
+    workspaceHistory: storageKey('workspace-retrieval-history'),
+    settings: namespace ? storageKey('settings-storage') : 'settings-storage',
+    searchHistory: namespace ? storageKey('search-history') : 'lightrag_search_history'
+  }
+}
