+++ b/lightrag_webui/src/hooks/useWorkspaceCatalog.ts
@@ -0,0 +1,59 @@
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { getWorkspaceCatalog, type WorkspaceCapabilities } from '@/api/workspaces'
+import { getRuntimeWorkspaceConfig } from '@/lib/runtimeConfig'
+
+/** Refresh display data without mutating the page's selected routing identity. */
+export function useWorkspaceCatalog() {
+  const config = getRuntimeWorkspaceConfig()
+  const [workspaces, setWorkspaces] = useState(config?.workspaces || [])
+  const [capabilities, setCapabilities] = useState<WorkspaceCapabilities>({})
+  const [refreshing, setRefreshing] = useState(false)
+  const [stale, setStale] = useState(false)
+  const mounted = useRef(true)
+  const inFlight = useRef<AbortController | null>(null)
+  const enabled = Boolean(config)
+  const hasStartingWorkspace = workspaces.some((row) => row.state === 'starting')
+  const refresh = useCallback(async () => {
+    if (!enabled || !mounted.current || inFlight.current) return
+    const controller = new AbortController()
+    inFlight.current = controller
+    setRefreshing(true)
+    try {
+      const next = await getWorkspaceCatalog(controller.signal)
+      if (mounted.current && !controller.signal.aborted) {
+        setWorkspaces(next.workspaces)
+        setCapabilities(next.capabilities || {})
+        setStale(false)
+      }
+    } catch {
+      if (mounted.current && !controller.signal.aborted) setStale(true)
+    } finally {
+      // An older aborted response cannot clear a newer mount's active request.
+      if (inFlight.current === controller) {
+        inFlight.current = null
+        if (mounted.current) setRefreshing(false)
+      }
+    }
+  }, [enabled])
+  useEffect(() => {
+    mounted.current = true
+    let active = true
+    if (!enabled) return () => { active = false; mounted.current = false }
+    // Guard this effect generation as well as clearing timers: an already
+    // queued callback must not fetch after unmount or a StrictMode remount.
+    const onFocus = () => { if (active) void refresh() }
+    const initial = setTimeout(onFocus, 0)
+    const interval = setInterval(() => { if (active && !document.hidden) void refresh() }, hasStartingWorkspace ? 5000 : 30000)
+    window.addEventListener('focus', onFocus)
+    return () => {
+      active = false
+      mounted.current = false
+      clearTimeout(initial)
+      clearInterval(interval)
+      window.removeEventListener('focus', onFocus)
+      inFlight.current?.abort()
+      inFlight.current = null
+    }
+  }, [enabled, refresh, hasStartingWorkspace])
+  return { workspaces, capabilities, refresh, refreshing, stale }
+}
