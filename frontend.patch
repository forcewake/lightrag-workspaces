+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test'
+import { cleanup, screen, waitFor, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { renderWithProviders } from '@/test/render'
+import WorkspaceSelector from './WorkspaceSelector'
+import { WORKSPACE_CREATION_KEY, WORKSPACE_FAVORITES_KEY } from '@/lib/workspaceCatalog'
+import type { RuntimeWorkspace } from '@/lib/runtimeConfig'
+
+const originalConfig = window.__LIGHTRAG_CONFIG__
+const originalUrl = window.location.href
+const initial: RuntimeWorkspace[] = [
+  { id: 'default', documents: 5, processed: 5, failed: 0, pending: 0, processing: 0, readOnly: false, state: 'ready', displayName: 'Main library', description: 'Reference documents', tags: ['reference'] },
+  { id: 'research', documents: 2, processed: 2, failed: 0, pending: 0, processing: 0, readOnly: false, state: 'stopped', displayName: 'Research notes', description: 'Ocean research', tags: ['marine'] }
+]
+const capabilities = { management: true, metadata: true, create: true, prewarm: true }
+let fetchSpy: ReturnType<typeof spyOn<typeof globalThis, 'fetch'>>
+let assign: ReturnType<typeof spyOn<typeof window.location, 'assign'>>
+let rows: RuntimeWorkspace[]
+let requests: { path: string; init?: RequestInit }[]
+let handler: (path: string, init?: RequestInit) => Response | Promise<Response>
+function json(data: unknown, status = 200) { return new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } }) }
+beforeEach(() => {
+  rows = initial.map((row) => ({ ...row }))
+  requests = []
+  window.__LIGHTRAG_CONFIG__ = { workspaceId: 'default', defaultWorkspace: 'default', workspaces: rows }
+  window.history.replaceState(null, '', '/workspaces/default/webui/')
+  localStorage.removeItem(WORKSPACE_FAVORITES_KEY)
+  sessionStorage.removeItem(WORKSPACE_CREATION_KEY)
+  handler = () => json({ workspaces: rows, capabilities })
+  fetchSpy = spyOn(globalThis, 'fetch').mockImplementation((async (input: RequestInfo | URL, init?: RequestInit) => {
+    const path = String(input); requests.push({ path, init }); return handler(path, init)
+  }) as typeof fetch)
+  assign = spyOn(window.location, 'assign').mockImplementation(() => {})
+})
+afterEach(() => {
+  cleanup(); fetchSpy.mockRestore(); assign.mockRestore()
+  localStorage.removeItem(WORKSPACE_FAVORITES_KEY); sessionStorage.removeItem(WORKSPACE_CREATION_KEY)
+  window.__LIGHTRAG_CONFIG__ = originalConfig
+  window.history.replaceState(null, '', originalUrl)
+})
+async function openCatalog() {
+  const user = userEvent.setup()
+  renderWithProviders(<WorkspaceSelector />)
+  await user.click(screen.getByRole('button', { name: 'Your workspaces' }))
+  await screen.findByRole('button', { name: 'New workspace' })
+  return user
+}
+
+describe('workspace catalog', () => {
+  test('searches names, descriptions and tags, keeps favorites separate from retrieval history', async () => {
+    localStorage.setItem('webui-retrieval-history', '["keep-this-history"]')
+    const user = await openCatalog()
+    await user.type(screen.getByRole('searchbox'), 'marine')
+    expect(screen.getByRole('heading', { name: 'Research notes' })).toBeInTheDocument()
+    expect(screen.queryByRole('heading', { name: 'Main library' })).not.toBeInTheDocument()
+    await user.click(screen.getByRole('button', { name: 'Favorite Research notes' }))
+    expect(JSON.parse(localStorage.getItem(WORKSPACE_FAVORITES_KEY)!)).toEqual(['research'])
+    expect(localStorage.getItem('webui-retrieval-history')).toBe('["keep-this-history"]')
+    await user.clear(screen.getByRole('searchbox'))
+    await user.click(screen.getByRole('checkbox', { name: 'Favorites only' }))
+    expect(screen.queryByRole('heading', { name: 'Main library' })).not.toBeInTheDocument()
+    await user.click(screen.getByRole('button', { name: 'Open workspace' }))
+    expect(assign).toHaveBeenCalledWith('/workspaces/research/webui/')
+    expect(window.__LIGHTRAG_CONFIG__?.workspaceId).toBe('default')
+    expect(requests.every(({ init }) => init?.method === 'GET')).toBe(true)
+    localStorage.removeItem('webui-retrieval-history')
+  })
+  test('refresh discovers new workspaces without changing selected ID or automatically starting workers', async () => {
+    const user = await openCatalog()
+    rows.push({ ...initial[1], id: 'new-library', displayName: 'New library' })
+    await user.click(screen.getByRole('button', { name: 'Refresh workspaces' }))
+    await screen.findByRole('heading', { name: 'New library' })
+    expect(window.__LIGHTRAG_CONFIG__?.workspaceId).toBe('default')
+    expect(assign).not.toHaveBeenCalled()
+    expect(requests.every(({ path, init }) => path === '/workspaces' && init?.method === 'GET')).toBe(true)
+  })
+  test('capability-disabled servers retain catalog and switching but hide writes', async () => {
+    handler = () => json({ workspaces: rows })
+    const user = userEvent.setup()
+    renderWithProviders(<WorkspaceSelector />)
+    await user.click(screen.getByRole('button', { name: 'Your workspaces' }))
+    expect(screen.queryByRole('button', { name: 'New workspace' })).not.toBeInTheDocument()
+    expect(screen.queryByRole('button', { name: 'Edit Main library' })).not.toBeInTheDocument()
+    await user.click(screen.getByRole('button', { name: 'Open workspace' }))
+    expect(assign).toHaveBeenCalledWith('/workspaces/research/webui/')
+  })
+  test('metadata edit uses the immutable ID and does not move stored data', async () => {
+    handler = (path, init) => {
+      if (init?.method === 'PATCH') {
+        expect(path).toBe('/workspaces/research/metadata')
+        const data = JSON.parse(String(init.body))
+        expect(data).toEqual({ displayName: 'Marine library', description: 'Ocean research', tags: ['marine'] })
+        rows[1] = { ...rows[1], ...data }
+        return json(data)
+      }
+      return json({ workspaces: rows, capabilities })
+    }
+    const user = await openCatalog()
+    await user.click(screen.getByRole('button', { name: 'Edit Research notes' }))
+    expect(screen.getByLabelText('Workspace ID', { exact: false })).toHaveAttribute('readonly')
+    const name = screen.getByLabelText('Name', { exact: true })
+    await user.clear(name); await user.type(name, 'Marine library')
+    await user.click(screen.getByRole('button', { name: 'Save details' }))
+    await screen.findByRole('heading', { name: 'Marine library' })
+    expect(requests.filter(({ init }) => init?.method === 'PATCH')).toHaveLength(1)
+    expect(assign).not.toHaveBeenCalled()
+  })
+  test('create follows operation progress and refreshes catalog before opening', async () => {
+    let polls = 0
+    handler = (path, init) => {
+      if (init?.method === 'POST') return json({ id: 'operation-1', state: 'pending', workspaceId: 'ocean-notes' }, 202)
+      if (path === '/workspace-operations/operation-1') {
+        polls++
+        rows.push({ ...initial[1], id: 'ocean-notes', displayName: 'Ocean notes', documents: 0 })
+        return json({ id: 'operation-1', state: 'succeeded', workspaceId: 'ocean-notes' })
+      }
+      return json({ workspaces: rows, capabilities })
+    }
+    const user = await openCatalog()
+    await user.click(screen.getByRole('button', { name: 'New workspace' }))
+    await user.type(screen.getByLabelText('Name', { exact: true }), 'Ocean notes')
+    await user.type(screen.getByLabelText('Workspace ID', { exact: false }), 'ocean-notes')
+    await user.click(screen.getByRole('button', { name: 'Create workspace' }))
+    await screen.findByText('Workspace created. It is ready to open.')
+    await screen.findByRole('heading', { name: 'Ocean notes' })
+    const creation = screen.getByRole('region', { name: 'Workspace creation' })
+    await user.click(within(creation).getByRole('button', { name: 'Open workspace' }))
+    expect(assign).toHaveBeenCalledWith('/workspaces/ocean-notes/webui/')
+    expect(polls).toBe(1)
+    expect(requests.filter(({ init }) => init?.method === 'POST')).toHaveLength(1)
+  })
+  test('lost create response keeps its exact request key and body; no automatic duplicate submission', async () => {
+    let posts = 0
+    handler = (_path, init) => {
+      if (init?.method === 'POST') {
+        posts++
+        if (posts === 1) throw new TypeError('connection lost')
+        return json({ id: 'recovered-operation', state: 'succeeded', workspaceId: 'ocean-notes' }, 202)
+      }
+      return json({ workspaces: rows, capabilities })
+    }
+    const user = await openCatalog()
+    await user.click(screen.getByRole('button', { name: 'New workspace' }))
+    await user.type(screen.getByLabelText('Workspace ID', { exact: false }), 'ocean-notes')
+    await user.click(screen.getByRole('button', { name: 'Create workspace' }))
+    await screen.findByText(/connection ended before creation was confirmed/i)
+    expect(posts).toBe(1)
+    const stored = JSON.parse(sessionStorage.getItem(WORKSPACE_CREATION_KEY)!)
+    expect(stored.body.id).toBe('ocean-notes')
+    await user.click(screen.getByRole('button', { name: 'Retry same creation' }))
+    await screen.findByText('Workspace created. It is ready to open.')
+    const writes = requests.filter(({ init }) => init?.method === 'POST')
+    expect(writes[0].init?.body).toBe(writes[1].init?.body)
+    expect((writes[0].init?.headers as Record<string, string>)['Idempotency-Key']).toBe(stored.key)
+    expect((writes[1].init?.headers as Record<string, string>)['Idempotency-Key']).toBe(stored.key)
+  })
+
+
+  test('closing the catalog aborts an operation poll without repeating creation', async () => {
+    let pollSignal: AbortSignal | undefined
+    handler = (path, init) => {
+      if (init?.method === 'POST') return json({ id: 'waiting-operation', state: 'running', workspaceId: 'ocean-notes' }, 202)
+      if (path === '/workspace-operations/waiting-operation') {
+        pollSignal = init?.signal || undefined
+        return new Promise<Response>((_resolve, reject) => {
+          pollSignal?.addEventListener('abort', () => reject(new DOMException('Aborted', 'AbortError')), { once: true })
+        })
+      }
+      return json({ workspaces: rows, capabilities })
+    }
+    const user = await openCatalog()
+    await user.click(screen.getByRole('button', { name: 'New workspace' }))
+    await user.type(screen.getByLabelText('Workspace ID', { exact: false }), 'ocean-notes')
+    await user.click(screen.getByRole('button', { name: 'Create workspace' }))
+    await waitFor(() => expect(pollSignal).toBeDefined())
+    await user.click(screen.getByRole('button', { name: /^Close$/ }))
+    expect(pollSignal?.aborted).toBe(true)
+    expect(requests.filter(({ init }) => init?.method === 'POST')).toHaveLength(1)
+    expect(JSON.parse(sessionStorage.getItem(WORKSPACE_CREATION_KEY)!).operation.id).toBe('waiting-operation')
+  })
+  test('a rejected validation can be edited, while an accepted request keeps its key', async () => {
+    handler = (_path, init) => init?.method === 'POST'
+      ? json({ code: 'invalid_metadata', retryable: false, detail: 'invalid' }, 422)
+      : json({ workspaces: rows, capabilities })
+    const user = await openCatalog()
+    await user.click(screen.getByRole('button', { name: 'New workspace' }))
+    await user.type(screen.getByLabelText('Workspace ID', { exact: false }), 'new-notes')
+    await user.click(screen.getByRole('button', { name: 'Create workspace' }))
+    await screen.findByRole('button', { name: 'Edit request' })
+    expect(screen.queryByRole('button', { name: 'Retry same creation' })).not.toBeInTheDocument()
+    await user.click(screen.getByRole('button', { name: 'Edit request' }))
+    expect(screen.getByLabelText('Workspace ID', { exact: false })).not.toHaveAttribute('readonly')
+    expect(screen.getByLabelText('Workspace ID', { exact: false })).toHaveValue('new-notes')
+    expect(sessionStorage.getItem(WORKSPACE_CREATION_KEY)).toBeNull()
+    expect(requests.filter(({ init }) => init?.method === 'POST')).toHaveLength(1)
+  })
+  test('failed discovery keeps the previous list and offers refresh', async () => {
+    handler = () => json({ detail: 'private database string should not display' }, 503)
+    const user = userEvent.setup()
+    renderWithProviders(<WorkspaceSelector />)
+    await user.click(screen.getByRole('button', { name: 'Your workspaces' }))
+    await waitFor(() => expect(screen.getByText(/Showing the last available list/)).toBeInTheDocument())
+    expect(screen.getByRole('heading', { name: 'Research notes' })).toBeInTheDocument()
+    expect(screen.queryByText(/private database/)).not.toBeInTheDocument()
+  })
+})
