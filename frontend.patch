@@ -0,0 +1,83 @@
+import { describe, expect, test } from 'bun:test'
+import { createWorkspaceStorageKeys, workspaceEntryPath } from './workspaceRouting'
+
+describe('workspace routing', () => {
+  test('preserves each entry and encodes workspace names as one URL segment', () => {
+    expect(workspaceEntryPath('meeting-notes', '/workspaces/archive/webui/')).toBe('/workspaces/meeting-notes/webui/')
+    expect(workspaceEntryPath('meeting-notes', '/workspaces/archive/workspace/')).toBe('/workspaces/meeting-notes/workspace/')
+    expect(workspaceEntryPath('notes & research', '/workspace.html')).toBe('/workspaces/notes%20%26%20research/workspace/')
+    expect(workspaceEntryPath('one/two', '/webui/')).toBe('/workspaces/one%2Ftwo/webui/')
+  })
+})
+
+describe('workspace browser state isolation', () => {
+  test('the actual persisted keys bind to the injected workspace before stores or migrations load', () => {
+    // Each entry load evaluates these module constants once. Separate Bun
+    // processes reproduce that startup ordering without changing cached
+    // singletons or browser globals shared by the rest of the test suite.
+    const readEntryKeys = (workspaceId: string) => {
+      const modulePath = new URL('./storageKeys.ts', import.meta.url).pathname
+      const script = `globalThis.window = { __LIGHTRAG_CONFIG__: ${JSON.stringify({ workspaceId, defaultWorkspace: 'default', workspaces: [{ id: workspaceId }] })} }; const keys = await import(${JSON.stringify(modulePath)}); console.log(JSON.stringify(Object.fromEntries(Object.entries(keys).filter(([name]) => name.endsWith('_KEY')))));`
+      const result = Bun.spawnSync([process.execPath, '--eval', script])
+      expect(result.exitCode).toBe(0)
+      return JSON.parse(result.stdout.toString()) as Record<string, string>
+    }
+    const primary = readEntryKeys('default')
+    const personal = readEntryKeys('meeting-notes')
+    expect(primary.LEGACY_SETTINGS_STORAGE_KEY).toBe('settings-storage')
+    expect(primary.WEBUI_RETRIEVAL_HISTORY_KEY).toBe('lightrag::webui-retrieval-history')
+    for (const name of Object.keys(primary)) {
+      expect(personal[name]).not.toBe(primary[name])
+      expect(personal[name]).toStartWith('lightrag:meeting-notes:')
+    }
+  })
+
+  test('keeps every original default-workspace key, including pre-split and graph-search history', () => {
+    const keys = createWorkspaceStorageKeys('default')
+    expect(keys).toEqual({
+      namespace: '',
+      settings: 'settings-storage',
+      querySettings: 'lightrag::query-settings-storage',
+      webuiHistory: 'lightrag::webui-retrieval-history',
+      workspaceHistory: 'lightrag::workspace-retrieval-history',
+      searchHistory: 'lightrag_search_history'
+    })
+    expect(createWorkspaceStorageKeys()).toEqual(keys)
+  })
+
+  test('the configured default retains legacy keys even when its ID is not default', () => {
+    const configured = createWorkspaceStorageKeys('custom-root', 'custom-root')
+    const other = createWorkspaceStorageKeys('default', 'custom-root')
+    expect(configured.namespace).toBe('')
+    expect(configured.settings).toBe('settings-storage')
+    expect(other.namespace).toBe('default')
+    expect(other.settings).toBe('lightrag:default:settings-storage')
+  })
+
+  test('partitions prompts, query settings, both conversations and graph searches between corpora', () => {
+    const primary = createWorkspaceStorageKeys('default')
+    const research = createWorkspaceStorageKeys('research')
+    const personal = createWorkspaceStorageKeys('meeting-notes')
+    const contentKeys = ['settings', 'querySettings', 'webuiHistory', 'workspaceHistory', 'searchHistory'] as const
+    const storage = new Map<string, string>()
+    for (const field of contentKeys) {
+      storage.set(primary[field], `default workspace ${field}`)
+      storage.set(research[field], `Research ${field}`)
+      storage.set(personal[field], `Personal ${field}`)
+    }
+    expect(storage.size).toBe(15)
+    for (const field of contentKeys) {
+      expect(storage.get(primary[field])).toBe(`default workspace ${field}`)
+      expect(storage.get(research[field])).toBe(`Research ${field}`)
+      expect(storage.get(personal[field])).toBe(`Personal ${field}`)
+      storage.delete(research[field])
+      expect(storage.get(primary[field])).toBe(`default workspace ${field}`)
+      expect(storage.get(personal[field])).toBe(`Personal ${field}`)
+    }
+  })
+
+  test('keeps legacy hyphenated workspace names distinct from underscored names', () => {
+    expect(createWorkspaceStorageKeys('meeting-notes').namespace).toBe('meeting-notes')
+    expect(createWorkspaceStorageKeys('meeting-notes').settings).not.toBe(createWorkspaceStorageKeys('meeting_notes').settings)
+  })
+})
diff --git a/lightrag_webui/src/lib/workspaceRouting.ts b/lightrag_webui/src/lib/workspaceRouting.ts
new file mode 100644
index 0000000..9d55b7d
--- /dev/null
+++ b/lightrag_webui/src/lib/workspaceRouting.ts
@@ -0,0 +1,29 @@
+export type WorkspaceEntry = 'webui' | 'workspace'
+
+/** Preserve the current entry, while dropping the previous corpus's route state. */
+export function workspaceEntryPath(workspaceId: string, pathname: string): string {
+  const entry: WorkspaceEntry = /\/(?:workspace(?:\/|\.html)?)(?:[^/]*)?$/.test(pathname)
+    ? 'workspace'
+    : 'webui'
+  return `/workspaces/${encodeURIComponent(workspaceId)}/${entry}/`
+}
+
+/**
+ * The configured default retains every pre-gateway browser key. Other corpora never read,
+ * migrate or overwrite those keys, including the old settings envelope that
+ * still owns prompt history and graph labels.
+ */
+export function createWorkspaceStorageKeys(workspaceId?: string, defaultWorkspace = 'default') {
+  const namespace = workspaceId && workspaceId !== defaultWorkspace
+    ? encodeURIComponent(workspaceId)
+    : ''
+  const storageKey = (name: string) => `lightrag:${namespace}:${name}`
+  return {
+    namespace,
+    querySettings: storageKey('query-settings-storage'),
+    webuiHistory: storageKey('webui-retrieval-history'),
+    workspaceHistory: storageKey('workspace-retrieval-history'),
+    settings: namespace ? storageKey('settings-storage') : 'settings-storage',
+    searchHistory: namespace ? storageKey('search-history') : 'lightrag_search_history'
+  }
+}
