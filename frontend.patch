+import { renderWithProviders } from '@/test/render'
+import type { LightragStatus } from '@/api/lightrag'
+import StatusCard from './StatusCard'
+
+const originalConfig = window.__LIGHTRAG_CONFIG__
+const status = {
+  input_directory: '/data/inputs/meeting-notes',
+  configuration: {
+    workspace: '',
