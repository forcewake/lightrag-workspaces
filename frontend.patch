+import { useTranslation } from 'react-i18next'
+import { LockKeyhole } from 'lucide-react'
+import { getRuntimeWorkspaceConfig } from '@/lib/runtimeConfig'
+
+export default function WorkspaceReadOnlyNotice() {
+  const { t } = useTranslation()
+  const config = getRuntimeWorkspaceConfig()
+  const workspace = config?.workspaces.find((item) => item.id === config.workspaceId)
+  if (!workspace?.readOnly) return null
+
+  return (
+    <div role="status" className="flex shrink-0 items-start gap-2 border-b border-amber-200 bg-amber-50 px-4 py-2 text-xs leading-relaxed text-amber-950 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-100">
+      <LockKeyhole className="mt-0.5 size-3.5 shrink-0" aria-hidden="true" />
+      <p>
+        <span className="font-medium">{workspace.id}: {t('workspace.switcher.readOnly', 'read only')}. </span>
+        {workspace.readOnlyReason || t('workspace.switcher.preservedNotice', 'Existing documents are preserved. Adding or changing documents is paused for this workspace.')}
+      </p>
+    </div>
+  )
+}
