@@ -0,0 +1,227 @@
+import { useEffect, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { ArrowLeft, FolderPlus, Pencil, RefreshCw, Search, Star } from 'lucide-react'
+import Button from '@/components/ui/Button'
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/Dialog'
+import type { RuntimeWorkspace } from '@/lib/runtimeConfig'
+import { createWorkspace, getWorkspaceOperation, prewarmWorkspace, updateWorkspaceMetadata, WorkspaceManagementError, type WorkspaceCapabilities, type WorkspaceCreation } from '@/api/workspaces'
+import { clearPendingCreation, filterWorkspaces, readFavorites, readPendingCreation, saveFavorites, savePendingCreation, type PendingCreation } from '@/lib/workspaceCatalog'
+import WorkspaceState from './WorkspaceState'
+import WorkspaceIssue from './WorkspaceIssue'
+
+interface Props {
+  open: boolean
+  onOpenChange: (value: boolean) => void
+  workspaces: RuntimeWorkspace[]
+  currentId: string
+  capabilities: WorkspaceCapabilities
+  refreshing: boolean
+  stale: boolean
+  refresh: () => Promise<void>
+  select: (id: string) => void
+}
+const inputClass = 'border-input bg-background w-full rounded-md border px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'
+const emptyForm: WorkspaceCreation = { id: '', displayName: '', description: '', tags: [] }
+
+export default function WorkspaceCatalog({ open, onOpenChange, workspaces, currentId, capabilities, refreshing, stale, refresh, select }: Props) {
+  const { t } = useTranslation()
+  const [query, setQuery] = useState('')
+  const [favorites, setFavorites] = useState(readFavorites)
+  const [onlyFavorites, setOnlyFavorites] = useState(false)
+  const [editor, setEditor] = useState<string | null>(null)
+  const [form, setForm] = useState<WorkspaceCreation>(emptyForm)
+  const [tagText, setTagText] = useState('')
+  const [pending, setPending] = useState<PendingCreation | undefined>(readPendingCreation)
+  const [working, setWorking] = useState(false)
+  const [polling, setPolling] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const [notice, setNotice] = useState<string | null>(null)
+  const alive = useRef(true)
+  const submission = useRef(false)
+  const canCreate = capabilities.management && capabilities.create
+  const canEdit = capabilities.management && capabilities.metadata
+  useEffect(() => { alive.current = true; return () => { alive.current = false } }, [])
+  useEffect(() => {
+    const onStorage = (event: StorageEvent) => { if (event.key === 'lightrag:workspace-catalog:favorites:v1') setFavorites(readFavorites()) }
+    window.addEventListener('storage', onStorage)
+    return () => window.removeEventListener('storage', onStorage)
+  }, [])
+  useEffect(() => {
+    if (!open) return
+    void refresh()
+  }, [open, refresh])
+  // Poll only a known operation. A lost POST response is never automatically
+  // repeated: the user can explicitly retry the same durable request key.
+  const operationId = pending?.operation?.id
+  const operationState = pending?.operation?.state
+  const pendingWorkspaceId = pending?.body.id
+  useEffect(() => {
+    if (!open || !operationId || !pendingWorkspaceId || !['pending', 'running'].includes(operationState || '')) return
+    let cancelled = false
+    const controller = new AbortController()
+    let timer: ReturnType<typeof setTimeout>
+    const deadline = Date.now() + 120000
+    const poll = async () => {
+      if (cancelled) return
+      try {
+        const operation = await getWorkspaceOperation(operationId, pendingWorkspaceId, controller.signal)
+        if (cancelled) return
+        setPending((previous) => {
+          if (!previous || previous.key !== pending?.key) return previous
+          const next = { ...previous, operation }
+          savePendingCreation(next)
+          return next
+        })
+        if (operation.state === 'succeeded') { setPolling(false); await refresh(); return }
+        if (operation.state === 'failed') { setPolling(false); return }
+        if (Date.now() >= deadline) { setError('stillWorking'); setPolling(false); return }
+        timer = setTimeout(poll, 2000)
+      } catch {
+        if (!cancelled) { setError('checkFailed'); setPolling(false) }
+      }
+    }
+    timer = setTimeout(() => { if (!cancelled) { setPolling(true); void poll() } }, 0)
+    return () => { cancelled = true; controller.abort(); clearTimeout(timer) }
+  }, [open, operationId, operationState, pendingWorkspaceId, pending?.key, refresh])
+
+  function startEditor(workspace?: RuntimeWorkspace) {
+    setError(null); setNotice(null)
+    setEditor(workspace?.id || '__new__')
+    setForm(workspace ? { id: workspace.id, displayName: workspace.displayName || workspace.id, description: workspace.description || '', tags: workspace.tags || [] } : emptyForm)
+    setTagText((workspace?.tags || []).join(', '))
+  }
+  function toggleFavorite(id: string) {
+    const next = favorites.includes(id) ? favorites.filter((value) => value !== id) : [...favorites, id]
+    setFavorites(next)
+    if (!saveFavorites(next)) setNotice('storageUnavailable')
+  }
+  function validTags() {
+    const tags = tagText.split(',').map((tag) => tag.trim()).filter(Boolean)
+    if (tags.length > 20 || tags.some((tag) => tag.length > 48)) { setError('invalidTags'); return false }
+    return true
+  }
+  async function submitCreation(intent?: PendingCreation) {
+    if (submission.current) return
+    submission.current = true
+    setWorking(true); setError(null)
+    try {
+      if (!intent && !validTags()) return
+      const body = { ...form, displayName: form.displayName.trim() || form.id, description: form.description.trim(), tags: tagText.split(',').map((tag) => tag.trim()).filter(Boolean) }
+      const next = intent || { key: Array.from(crypto.getRandomValues(new Uint8Array(24)), (byte) => byte.toString(16).padStart(2, '0')).join(''), body }
+      // Refuse a new write without durable retry identity. Existing intent stays
+      // in memory even if browser storage becomes unavailable afterwards.
+      if (!intent && !savePendingCreation(next)) { setError('saveRequestFailed'); return }
+      setPending(next)
+      const operation = await createWorkspace(next.body, next.key)
+      const saved = { ...next, operation }
+      savePendingCreation(saved)
+      if (alive.current) { setPending(saved); setEditor(null) }
+      if (operation.state === 'succeeded') await refresh()
+    } catch (cause) {
+      // These gateway validations run before accepting a creation operation.
+      // An explicit edit may use a fresh key; transport failures keep the old one.
+      if (cause instanceof WorkspaceManagementError && ['invalid_metadata', 'invalid_workspace_id', 'authentication_required', 'workspace_exists', 'json_required', 'request_too_large'].includes(cause.code)) {
+        setPending((previous) => {
+          if (!previous || previous.operation) return previous
+          const rejected = { ...previous, rejectionCode: cause.code }
+          savePendingCreation(rejected)
+          return rejected
+        })
+      }
+      if (alive.current) setError(cause instanceof WorkspaceManagementError && !cause.uncertain ? 'creationRejected' : 'creationUncertain')
+    } finally { submission.current = false; if (alive.current) setWorking(false) }
+  }
+  async function saveMetadata() {
+    if (submission.current) return
+    submission.current = true; setWorking(true); setError(null)
+    try {
+      if (!validTags()) return
+      await updateWorkspaceMetadata(form.id, { displayName: form.displayName.trim() || form.id, description: form.description.trim(), tags: tagText.split(',').map((tag) => tag.trim()).filter(Boolean) })
+      await refresh()
+      if (alive.current) { setEditor(null); setNotice('metadataSaved') }
+    } catch { if (alive.current) setError('metadataFailed') }
+    finally { submission.current = false; if (alive.current) setWorking(false) }
+  }
+  async function checkCreation() {
+    if (!pending?.operation) return
+    setWorking(true); setError(null)
+    try {
+      const operation = await getWorkspaceOperation(pending.operation.id, pending.body.id)
+      const next = { ...pending, operation }
+      savePendingCreation(next)
+      if (alive.current) setPending(next)
+      await refresh()
+    } catch { if (alive.current) setError('checkFailed') }
+    finally { if (alive.current) setWorking(false) }
+  }
+  async function startWorkspace(id: string) {
+    setWorking(true); setError(null)
+    try { await prewarmWorkspace(id); await refresh() }
+    catch { if (alive.current) setError('startFailed') }
+    finally { if (alive.current) setWorking(false) }
+  }
+  const rows = filterWorkspaces(workspaces, query, favorites, onlyFavorites)
+  return <Dialog open={open} onOpenChange={onOpenChange}>
+    <DialogContent className="max-h-[90dvh] max-w-2xl overflow-y-auto p-5 sm:p-6">
+      <DialogHeader>
+        <DialogTitle>{t('workspace.catalog.title', 'Your workspaces')}</DialogTitle>
+        <DialogDescription>{t('workspace.catalog.description', 'Find a collection of documents, or create a separate space for a new topic.')}</DialogDescription>
+      </DialogHeader>
+      {error && <p role="alert" className="rounded-md bg-red-50 p-3 text-sm text-red-900 dark:bg-red-950 dark:text-red-100">{t(`workspace.catalog.errors.${error}`)}</p>}
+      {notice && <p role="status" className="text-muted-foreground text-sm">{t(`workspace.catalog.${notice}`)}</p>}
