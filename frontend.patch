@@ -0,0 +1,44 @@
+import { useId } from 'react'
+import { useTranslation } from 'react-i18next'
+import { ChevronDown } from 'lucide-react'
+import { getRuntimeWorkspaceConfig } from '@/lib/runtimeConfig'
+import { workspaceEntryPath } from '@/lib/workspaceRouting'
+
+export default function WorkspaceSelector() {
+  const { t } = useTranslation()
+  const id = useId()
+  const config = getRuntimeWorkspaceConfig()
+  if (!config) return null
+
+  const changeWorkspace = (workspaceId: string) => {
+    if (workspaceId === config.workspaceId) return
+    if (!config.workspaces.some((workspace) => workspace.id === workspaceId)) return
+    // Navigation destroys the old query, document and graph state. The URL,
+    // rather than a shared cookie or localStorage choice, keeps tabs isolated.
+    window.location.assign(workspaceEntryPath(workspaceId, window.location.pathname))
+  }
+
+  return (
+    <div className="flex min-w-0 items-center gap-2">
+      <label htmlFor={id} className="text-muted-foreground hidden text-xs lg:inline">
+        {t('workspace.switcher.label', 'Workspace')}
+      </label>
+      <div className="relative min-w-0">
+        <select
+          id={id}
+          aria-label={t('workspace.switcher.label', 'Workspace')}
+          value={config.workspaceId}
+          onChange={(event) => changeWorkspace(event.target.value)}
+          className="border-input bg-background text-foreground focus-visible:ring-ring h-8 max-w-[10rem] min-w-24 cursor-pointer appearance-none truncate rounded-md border py-1 pr-7 pl-2 text-xs focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none sm:max-w-[13rem]"
+        >
+          {config.workspaces.map((workspace) => (
+            <option key={workspace.id} value={workspace.id}>
+              {workspace.id} ({workspace.documents}){workspace.readOnly ? ` — ${t('workspace.switcher.readOnly', 'read only')}` : ''}
+            </option>
+          ))}
+        </select>
+        <ChevronDown className="text-muted-foreground pointer-events-none absolute top-2 right-2 size-4" aria-hidden="true" />
+      </div>
+    </div>
+  )
+}
