@@ -0,0 +1,16 @@
+import { useTranslation } from 'react-i18next'
+import type { RuntimeWorkspace } from '@/lib/runtimeConfig'
+
+const colors: Record<string, string> = {
+  stopped: 'bg-muted text-muted-foreground', starting: 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-200',
+  ready: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200',
+  busy: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
+  failed: 'bg-red-100 text-red-900 dark:bg-red-950 dark:text-red-200'
+}
+export default function WorkspaceState({ workspace }: { workspace?: RuntimeWorkspace }) {
+  const { t } = useTranslation()
+  if (!workspace?.state) return null
+  return <span className={`inline-flex shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium ${colors[workspace.state] || colors.stopped}`}>
+    {t(`workspace.catalog.states.${workspace.state}`, workspace.state)}
+  </span>
+}
