@@ -0,0 +1,72 @@
+import { useTranslation } from 'react-i18next'
+import { ZapIcon } from 'lucide-react'
+import { getRuntimeWorkspaceConfig } from '@/lib/runtimeConfig'
+import WorkspaceSelector from './WorkspaceSelector'
+import WorkspaceReadOnlyNotice from './WorkspaceReadOnlyNotice'
+import type { WorkspaceBootstrapError } from '@/api/errors'
+import Button from '@/components/ui/Button'
+import WorkspaceIssue from './WorkspaceIssue'
+
+interface WorkspaceOpeningProps {
+  error?: WorkspaceBootstrapError | null
+}
+
+/** A loading explanation shared by both entries; never changes auth decisions. */
+export function WorkspaceOpeningStatus({ error }: WorkspaceOpeningProps) {
+  const { t } = useTranslation()
+  const config = getRuntimeWorkspaceConfig()
+  if (config && error) {
+    const workspace = config.workspaces.find((item) => item.id === config.workspaceId)
+    const explanation = error.status === 409 && workspace?.readOnlyReason
+      ? workspace.readOnlyReason
+      : t(`workspace.switcher.openingError.${error.reason}`, {
+        defaultValue: 'The workspace is unavailable. Try again or choose another workspace.'
+      })
+    return (
+      <div role="alert" className="flex max-w-md flex-col items-center gap-3 px-4 text-center">
+        <p className="text-sm font-medium">
+          {t('workspace.switcher.openingFailed', { defaultValue: 'Could not open workspace {{workspace}}', workspace: config.workspaceId })}
+        </p>
+        <p className="text-muted-foreground text-sm leading-relaxed">{error.code ? <WorkspaceIssue code={error.code} retryable={error.retryable} retryAfterSeconds={error.retryAfterSeconds} /> : explanation}</p>
+        {error.retryable !== false && <Button type="button" variant="outline" onClick={() => window.location.reload()}>
+          {t('workspace.switcher.retry', 'Try again')}
+        </Button>}
+      </div>
+    )
+  }
+  return (
+    <div role="status" aria-label={config ? undefined : 'Loading'} className="flex flex-col items-center gap-3 px-4 text-center">
+      <div className="border-primary size-8 animate-spin rounded-full border-4 border-t-transparent" aria-hidden="true" />
+      {config && (
+        <>
+          <p className="text-sm font-medium">
+            {t('workspace.switcher.opening', { defaultValue: 'Opening workspace {{workspace}}…', workspace: config.workspaceId })}
+          </p>
+          <p className="text-muted-foreground max-w-sm text-xs leading-relaxed">
+            {t('workspace.switcher.firstVisit', 'The first visit can take a little longer while your documents load.')}
+          </p>
+        </>
+      )}
+    </div>
+  )
+}
+
+/** The selector stays available while a slow workspace opens. */
+export default function WorkspaceOpening({ error }: WorkspaceOpeningProps) {
+  if (!getRuntimeWorkspaceConfig()) return null
+  return (
+    <div className="bg-background flex h-dvh w-screen flex-col">
+      <header className="border-border/40 flex min-h-11 shrink-0 flex-wrap items-center gap-3 border-b px-4">
+        <span className="flex items-center gap-2 text-sm font-bold">
+          <ZapIcon className="size-4 text-emerald-400" aria-hidden="true" />
+          LightRAG
+        </span>
+        <WorkspaceSelector />
+      </header>
+      <WorkspaceReadOnlyNotice />
+      <div className="flex flex-1 items-center justify-center">
+        <WorkspaceOpeningStatus error={error} />
+      </div>
+    </div>
+  )
+}
