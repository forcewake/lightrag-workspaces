+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test'
+import { cleanup, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { renderWithProviders } from '@/test/render'
+import WorkspaceSelector from './WorkspaceSelector'
+import WorkspaceReadOnlyNotice from './WorkspaceReadOnlyNotice'
+import type { RuntimeWorkspace } from '@/lib/runtimeConfig'
+
+const originalConfig = window.__LIGHTRAG_CONFIG__
+const originalUrl = window.location.href
+const workspaces: RuntimeWorkspace[] = [
+  { id: 'default', documents: 24, processed: 22, failed: 2, pending: 0, processing: 0, readOnly: false },
+  { id: 'meeting-notes', documents: 221, processed: 0, failed: 0, pending: 220, processing: 1, readOnly: true }
+]
+let assign: ReturnType<typeof spyOn<typeof window.location, 'assign'>>
+
+beforeEach(() => {
+  window.__LIGHTRAG_CONFIG__ = { workspaceId: 'default', defaultWorkspace: 'default', workspaces }
+  window.history.replaceState(null, '', '/workspaces/default/webui/')
+  assign = spyOn(window.location, 'assign').mockImplementation(() => {})
+})
+
+afterEach(() => {
+  cleanup()
+  assign.mockRestore()
+  window.__LIGHTRAG_CONFIG__ = originalConfig
+  window.history.replaceState(null, '', originalUrl)
+})
+
+describe('workspace selector', () => {
+  test('has an accessible name, current selection, document counts and read-only state', () => {
+    renderWithProviders(<WorkspaceSelector />)
+    expect(screen.getByRole('combobox', { name: 'Workspace' })).toHaveValue('default')
+    expect(screen.getByRole('option', { name: 'default (24)' })).toBeInTheDocument()
+    expect(screen.getByRole('option', { name: 'meeting-notes (221) — read only' })).toBeInTheDocument()
+  })
+
+  test('switches the admin page by full navigation, keeping the exact workspace name', async () => {
+    const user = userEvent.setup()
+    renderWithProviders(<WorkspaceSelector />)
+    await user.selectOptions(screen.getByRole('combobox', { name: 'Workspace' }), 'meeting-notes')
+    expect(assign).toHaveBeenCalledTimes(1)
+    expect(assign).toHaveBeenCalledWith('/workspaces/meeting-notes/webui/')
+    // A selection in this tab does not modify the global configuration or a
+    // persisted choice that would silently retarget requests in another tab.
+    expect(window.__LIGHTRAG_CONFIG__?.workspaceId).toBe('default')
+  })
+
+  test('keeps the query-only entry when switching, without a previous chat route', async () => {
+    window.history.replaceState(null, '', '/workspaces/default/workspace/#/welcome')
+    const user = userEvent.setup()
+    renderWithProviders(<WorkspaceSelector />)
+    await user.selectOptions(screen.getByRole('combobox', { name: 'Workspace' }), 'meeting-notes')
+    expect(assign).toHaveBeenCalledWith('/workspaces/meeting-notes/workspace/')
+  })
+
+  test('does not navigate when selecting the current workspace', async () => {
+    const user = userEvent.setup()
+    renderWithProviders(<WorkspaceSelector />)
+    await user.selectOptions(screen.getByRole('combobox', { name: 'Workspace' }), 'default')
+    expect(assign).not.toHaveBeenCalled()
+  })
+
+  test('remains absent on an ordinary deployment without gateway metadata', () => {
+    window.__LIGHTRAG_CONFIG__ = {}
+    renderWithProviders(<WorkspaceSelector />)
+    expect(screen.queryAllByRole('combobox')).toHaveLength(0)
+  })
+})
+
+describe('preserved workspace notice', () => {
+  test('names the read-only workspace and explains that documents are preserved', () => {
+    window.__LIGHTRAG_CONFIG__!.workspaceId = 'meeting-notes'
+    renderWithProviders(<WorkspaceReadOnlyNotice />)
+    expect(screen.getByRole('status')).toHaveTextContent('meeting-notes: read only.')
+    expect(screen.getByRole('status')).toHaveTextContent('Existing documents are preserved.')
+  })
+
+  test('uses the supplied reason for incompatible workspaces', () => {
+    window.__LIGHTRAG_CONFIG__ = {
+      workspaceId: 'archive',
+      workspaces: [{ ...workspaces[1], id: 'archive', readOnlyReason: 'These documents need their original model settings before they can be used.' }]
+    }
+    renderWithProviders(<WorkspaceReadOnlyNotice />)
+    expect(screen.getByRole('status')).toHaveTextContent('These documents need their original model settings before they can be used.')
+  })
+
+  test('does not warn for a writable workspace', () => {
+    renderWithProviders(<WorkspaceReadOnlyNotice />)
+    expect(screen.queryAllByRole('status')).toHaveLength(0)
+  })
+})
