diff --git a/lightrag_webui/src/api/errors.ts b/lightrag_webui/src/api/errors.ts
index d88c7d7..67dcc14 100644
--- a/lightrag_webui/src/api/errors.ts
+++ b/lightrag_webui/src/api/errors.ts
@@ -25,3 +25,19 @@ export function isAuthenticationRequiredError(
     (error instanceof Error && error.name === 'AuthenticationRequiredError')
   )
 }
+
+/** Opening a corpus failed; this says nothing about whether sign-in is required. */
+export class WorkspaceBootstrapError extends Error {
+  constructor(
+    public readonly reason: 'unavailable' | 'timeout' | 'network' | 'invalid_response',
+    public readonly status?: number
+  ) {
+    super('Workspace could not be opened')
+    this.name = 'WorkspaceBootstrapError'
+  }
+}
+
+export function isWorkspaceBootstrapError(error: unknown): error is WorkspaceBootstrapError {
+  return error instanceof WorkspaceBootstrapError ||
+    (error instanceof Error && error.name === 'WorkspaceBootstrapError')
+}
