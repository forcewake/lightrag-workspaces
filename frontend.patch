+import { afterEach, describe, expect, spyOn, test } from 'bun:test'
+import { cleanup, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { renderWithProviders } from '@/test/render'
+import WorkspaceOpening from './WorkspaceOpening'
+import { WorkspaceBootstrapError } from '@/api/errors'
+
+const originalConfig = window.__LIGHTRAG_CONFIG__
+const originalUrl = window.location.href
+
+afterEach(() => {
+  cleanup()
+  window.__LIGHTRAG_CONFIG__ = originalConfig
+  window.history.replaceState(null, '', originalUrl)
+})
+
+describe('opening a cold workspace', () => {
+  test('names the workspace and lets the user switch away before startup finishes', async () => {
+    window.__LIGHTRAG_CONFIG__ = {
+      workspaceId: 'research',
+      workspaces: ['research', 'default'].map((id) => ({ id, documents: 1, processed: 1, failed: 0, pending: 0, processing: 0, readOnly: false }))
+    }
+    window.history.replaceState(null, '', '/workspaces/research/webui/')
+    const assign = spyOn(window.location, 'assign').mockImplementation(() => {})
+    try {
+      const user = userEvent.setup()
+      renderWithProviders(<WorkspaceOpening />)
+      expect(screen.getByRole('status')).toHaveTextContent('Opening workspace research…')
+      expect(screen.getByRole('status')).toHaveTextContent('while your documents load')
+      expect(screen.queryAllByRole('textbox', { name: /username/i })).toHaveLength(0)
+      await user.selectOptions(screen.getByRole('combobox', { name: 'Workspace' }), 'default')
+      expect(assign).toHaveBeenCalledWith('/workspaces/default/webui/')
+    } finally {
+      assign.mockRestore()
+    }
+  })
+
+  test('leaves the ordinary deployment bootstrap presentation unchanged', () => {
+    window.__LIGHTRAG_CONFIG__ = {}
+    renderWithProviders(<WorkspaceOpening />)
+    expect(screen.queryAllByRole('status')).toHaveLength(0)
+    expect(screen.queryAllByRole('combobox')).toHaveLength(0)
+  })
+
+  test('an unavailable workspace shows its reason, retry and selector without credentials', async () => {
+    window.__LIGHTRAG_CONFIG__ = {
+      workspaceId: 'research',
+      workspaces: [{ id: 'research', documents: 1, processed: 1, failed: 0, pending: 0, processing: 0, readOnly: true, readOnlyReason: 'These documents need their original model settings.' }]
+    }
+    const reload = spyOn(window.location, 'reload').mockImplementation(() => {})
+    try {
+      const user = userEvent.setup()
+      renderWithProviders(<WorkspaceOpening error={new WorkspaceBootstrapError('unavailable', 409)} />)
+      expect(screen.getByRole('alert')).toHaveTextContent('Could not open workspace research')
+      expect(screen.getByRole('alert')).toHaveTextContent('These documents need their original model settings.')
+      expect(screen.getByRole('combobox', { name: 'Workspace' })).toBeInTheDocument()
+      expect(screen.queryAllByRole('textbox')).toHaveLength(0)
+      await user.click(screen.getByRole('button', { name: 'Try again' }))
+      expect(reload).toHaveBeenCalledTimes(1)
+    } finally {
+      reload.mockRestore()
+    }
+  })
+})
