@@ -0,0 +1,93 @@
+import type { RuntimeWorkspace } from '@/lib/runtimeConfig'
+import { useSettingsStore } from '@/stores/settings'
+
+export interface WorkspaceCapabilities {
+  management?: boolean
+  metadata?: boolean
+  create?: boolean
+  prewarm?: boolean
+}
+export interface WorkspaceCatalog {
+  workspaces: RuntimeWorkspace[]
+  capabilities?: WorkspaceCapabilities
+}
+export interface WorkspaceMetadata {
+  displayName: string
+  description: string
+  tags: string[]
+}
+export interface WorkspaceCreation extends WorkspaceMetadata { id: string }
+export interface WorkspaceOperation {
+  id: string
+  state: 'pending' | 'running' | 'succeeded' | 'failed'
+  workspaceId: string
+  errorCode?: string | null
+  retryable?: boolean
+}
+export class WorkspaceManagementError extends Error {
+  constructor(public readonly code: string, public readonly retryable: boolean, public readonly uncertain = false) {
+    super(code)
+    this.name = 'WorkspaceManagementError'
+  }
+}
+
+// Never reuse the worker client: discovery and management stay at the gateway
+// root even when a worker is asleep or the page uses a scoped API prefix.
+async function request<T>(path: string, method = 'GET', body?: unknown, idempotencyKey?: string, signal?: AbortSignal): Promise<T> {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), 15000)
+  const abort = () => controller.abort()
+  signal?.addEventListener('abort', abort, { once: true })
+  if (signal?.aborted) controller.abort()
+  const headers: Record<string, string> = { Accept: 'application/json' }
+  const apiKey = useSettingsStore.getState().apiKey
+  if (apiKey) headers['X-API-Key'] = apiKey
+  try {
+    const token = localStorage.getItem('LIGHTRAG-API-TOKEN')
+    if (token) headers.Authorization = `Bearer ${token}`
+  } catch { /* Storage may be unavailable; the server still decides access. */ }
+  if (body !== undefined) headers['Content-Type'] = 'application/json'
+  if (idempotencyKey) headers['Idempotency-Key'] = idempotencyKey
+  try {
+    const response = await fetch(path, {
+      method, headers, body: body === undefined ? undefined : JSON.stringify(body),
+      credentials: 'same-origin', cache: 'no-store', signal: controller.signal
+    })
+    const data = await response.json().catch(() => null)
+    if (!response.ok) {
+      const error = data?.detail && typeof data.detail === 'object' ? data.detail : data
+      throw new WorkspaceManagementError(typeof error?.code === 'string' ? error.code : `http_${response.status}`, error?.retryable === true)
+    }
+    if (!data || typeof data !== 'object') throw new WorkspaceManagementError('invalid_response', false, method !== 'GET')
+    return data as T
+  } catch (error) {
+    if (error instanceof WorkspaceManagementError) throw error
+    throw new WorkspaceManagementError('connection', true, method !== 'GET')
+  } finally { clearTimeout(timer); signal?.removeEventListener('abort', abort) }
+}
+
+export async function getWorkspaceCatalog(signal?: AbortSignal): Promise<WorkspaceCatalog> {
+  const data = await request<WorkspaceCatalog>('/workspaces', 'GET', undefined, undefined, signal)
+  if (!Array.isArray(data.workspaces) || !data.workspaces.every((row) => typeof row.id === 'string')) {
+    throw new WorkspaceManagementError('invalid_response', false)
+  }
+  return data
+}
+export async function createWorkspace(body: WorkspaceCreation, key: string): Promise<WorkspaceOperation> {
+  return validateOperation(await request<WorkspaceOperation>('/workspaces', 'POST', body, key), body.id)
+}
+export async function getWorkspaceOperation(id: string, workspaceId: string, signal?: AbortSignal): Promise<WorkspaceOperation> {
+  return validateOperation(await request<WorkspaceOperation>(`/workspace-operations/${encodeURIComponent(id)}`, 'GET', undefined, undefined, signal), workspaceId)
+}
+function validateOperation(data: WorkspaceOperation, workspaceId: string): WorkspaceOperation {
+  if (!data.id || data.workspaceId !== workspaceId || !['pending', 'running', 'succeeded', 'failed'].includes(data.state)) {
+    throw new WorkspaceManagementError('invalid_response', false, true)
+  }
+  return data
+}
+export function updateWorkspaceMetadata(id: string, body: WorkspaceMetadata): Promise<WorkspaceMetadata> {
+  return request(`/workspaces/${encodeURIComponent(id)}/metadata`, 'PATCH', body)
+}
+export function prewarmWorkspace(id: string): Promise<RuntimeWorkspace> {
+  return request(`/workspaces/${encodeURIComponent(id)}/prewarm`, 'POST')
+}
