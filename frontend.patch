@@ -0,0 +1,35 @@
+import type { WorkspaceCreation, WorkspaceOperation } from '@/api/workspaces'
+import type { RuntimeWorkspace } from './runtimeConfig'
+
+export const WORKSPACE_FAVORITES_KEY = 'lightrag:workspace-catalog:favorites:v1'
+export const WORKSPACE_CREATION_KEY = 'lightrag:workspace-catalog:pending-creation:v1'
+export interface PendingCreation { key: string; body: WorkspaceCreation; operation?: WorkspaceOperation; rejectionCode?: string }
+
+export function readFavorites(): string[] {
+  try {
+    const saved: unknown = JSON.parse(localStorage.getItem(WORKSPACE_FAVORITES_KEY) || '[]')
+    return Array.isArray(saved) ? saved.filter((id): id is string => typeof id === 'string') : []
+  } catch { return [] }
+}
+export function saveFavorites(ids: string[]): boolean {
+  try { localStorage.setItem(WORKSPACE_FAVORITES_KEY, JSON.stringify(ids)); return true } catch { return false }
+}
+export function readPendingCreation(): PendingCreation | undefined {
+  try {
+    const value = JSON.parse(sessionStorage.getItem(WORKSPACE_CREATION_KEY) || 'null') as PendingCreation | null
+    if (value?.key && value.body?.id && typeof value.body.displayName === 'string' && typeof value.body.description === 'string' && Array.isArray(value.body.tags)) return value
+  } catch { /* Invalid or inaccessible storage must not create a request. */ }
+}
+export function savePendingCreation(value: PendingCreation): boolean {
+  try { sessionStorage.setItem(WORKSPACE_CREATION_KEY, JSON.stringify(value)); return true } catch { return false }
+}
+export function clearPendingCreation() {
+  try { sessionStorage.removeItem(WORKSPACE_CREATION_KEY) } catch { /* Keep usable in private browsing. */ }
+}
+export function filterWorkspaces(workspaces: RuntimeWorkspace[], query: string, favorites: string[], onlyFavorites: boolean): RuntimeWorkspace[] {
+  const terms = query.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean)
+  return workspaces.filter((row) => {
+    const text = [row.id, row.displayName, row.description, ...(row.tags || [])].join(' ').toLocaleLowerCase()
+    return (!onlyFavorites || favorites.includes(row.id)) && terms.every((term) => text.includes(term))
+  }).sort((a, b) => Number(favorites.includes(b.id)) - Number(favorites.includes(a.id)) || (a.displayName || a.id).localeCompare(b.displayName || b.id))
+}
