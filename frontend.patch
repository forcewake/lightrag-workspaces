+import { useEffect, useId, useRef, useState, type KeyboardEvent } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Check, ChevronDown, FileText, RefreshCw, Search, Star, X } from 'lucide-react'
+import { getRuntimeWorkspaceConfig } from '@/lib/runtimeConfig'
+import { workspaceEntryPath } from '@/lib/workspaceRouting'
+import { filterWorkspaces, readFavorites, WORKSPACE_FAVORITES_KEY } from '@/lib/workspaceCatalog'
+import { useWorkspaceCatalog } from '@/hooks/useWorkspaceCatalog'
+import { Popover, PopoverContent, PopoverTrigger } from './ui/Popover'
+import WorkspaceCatalog from './WorkspaceCatalog'
+import WorkspaceState from './WorkspaceState'
+import Button from './ui/Button'
+
+export default function WorkspaceSelector() {
+  const { t } = useTranslation()
+  const id = useId()
+  const config = getRuntimeWorkspaceConfig()
+  const catalog = useWorkspaceCatalog()
+  const [catalogOpen, setCatalogOpen] = useState(false)
+  const [pickerOpen, setPickerOpen] = useState(false)
+  const [query, setQuery] = useState('')
+  const [favorites, setFavorites] = useState(readFavorites)
+  const [highlightedId, setHighlightedId] = useState<string>()
+  const search = useRef<HTMLInputElement>(null)
+  const rows = filterWorkspaces(catalog.workspaces, query, favorites, false)
+  if (!query.trim()) rows.sort((a, b) => Number(b.id === config?.workspaceId) - Number(a.id === config?.workspaceId))
+  // Resolve by immutable ID, not position: a refresh can reorder or remove rows
+  // while the user is typing. aria-activedescendant must always name a real row.
+  const activeId = rows.some((row) => row.id === highlightedId) ? highlightedId : rows[0]?.id
+  const activeOptionId = activeId ? `${id}-option-${encodeURIComponent(activeId)}` : undefined
+  const current = catalog.workspaces.find((row) => row.id === config?.workspaceId)
+    || config?.workspaces.find((row) => row.id === config.workspaceId)
+  useEffect(() => {
+    const onStorage = (event: StorageEvent) => {
+      if (event.key === WORKSPACE_FAVORITES_KEY || event.key === null) setFavorites(readFavorites())
+    }
+    window.addEventListener('storage', onStorage)
+    return () => window.removeEventListener('storage', onStorage)
+  }, [])
+  useEffect(() => {
+    if (pickerOpen && activeOptionId) document.getElementById(activeOptionId)?.scrollIntoView?.({ block: 'nearest' })
+  }, [pickerOpen, activeOptionId])
+  if (!config) return null
+
+  const changeWorkspace = (workspaceId: string) => {
+    if (workspaceId === config.workspaceId) return
+    if (!catalog.workspaces.some((workspace) => workspace.id === workspaceId)) return
+    // Navigation destroys the old query, document and graph state. The URL,
+    // rather than a shared cookie or localStorage choice, keeps tabs isolated.
+    window.location.assign(workspaceEntryPath(workspaceId, window.location.pathname))
+  }
+  const openPicker = (open: boolean) => {
+    setPickerOpen(open)
+    if (open) {
+      setQuery('')
+      setHighlightedId(config.workspaceId)
+      // The catalog can change favorites in this tab; storage events cover
+      // other tabs. Neither path writes selection or retrieval history.
+      setFavorites(readFavorites())
+      void catalog.refresh()
+    }
+  }
+  const choose = (workspaceId: string) => {
+    setPickerOpen(false)
+    changeWorkspace(workspaceId)
+  }
+  const onSearchKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.nativeEvent.isComposing || event.keyCode === 229 || event.altKey || event.ctrlKey || event.metaKey) return
+    const index = rows.findIndex((row) => row.id === activeId)
+    let next: number | undefined
+    if (event.key === 'ArrowDown') next = Math.min(index + 1, rows.length - 1)
+    if (event.key === 'ArrowUp') next = Math.max(index - 1, 0)
+    if (event.key === 'Home') next = 0
+    if (event.key === 'End') next = rows.length - 1
+    if (next !== undefined) {
+      event.preventDefault()
+      setHighlightedId(rows[next]?.id)
+    } else if (event.key === 'Enter') {
+      event.preventDefault()
+      if (activeId) choose(activeId)
+    }
+    // Escape and outside focus/click are handled by Radix, including focus
+    // returning to the trigger without stealing focus from an outside target.
+  }
+  const clearSearch = () => { setQuery(''); setHighlightedId(config.workspaceId); search.current?.focus() }
+
+  return (
+    <div className="flex min-w-0 items-center gap-2">
+      <span className="text-muted-foreground hidden text-xs lg:inline">{t('workspace.switcher.label', 'Workspace')}</span>
+      <Popover open={pickerOpen} onOpenChange={openPicker}>
+        <PopoverTrigger asChild>
+          <Button
+            type="button"
+            variant="outline"
+            aria-label={t('workspace.switcher.label', 'Workspace')}
+            aria-describedby={`${id}-current`}
+            className="h-8 max-w-[10rem] min-w-24 justify-between gap-2 px-2 text-xs font-normal sm:max-w-[13rem]"
+            onKeyDown={(event) => {
+              if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); openPicker(true) }
+            }}
+          >
+            <span id={`${id}-current`} className="truncate">{current?.displayName || config.workspaceId}{current ? ` (${current.documents})` : ''}</span>
+            <ChevronDown className="text-muted-foreground" aria-hidden="true" />
+          </Button>
+        </PopoverTrigger>
+        <PopoverContent
+          align="start"
+          sideOffset={6}
+          collisionPadding={12}
+          avoidCollisions
+          aria-label={t('workspace.switcher.choose', 'Choose a workspace')}
+          className="flex max-h-[min(28rem,calc(100dvh-1.5rem),var(--radix-popover-content-available-height))] w-[min(22rem,calc(100vw-1.5rem))] flex-col overflow-hidden p-0"
+          onOpenAutoFocus={(event) => { event.preventDefault(); search.current?.focus() }}
+        >
+          <div className="flex shrink-0 items-center gap-1 border-b p-2">
+            <Search className="text-muted-foreground ml-1 size-4 shrink-0" aria-hidden="true" />
+            <input
+              ref={search}
+              role="combobox"
+              aria-label={t('workspace.catalog.search', 'Search workspaces')}
+              aria-expanded={pickerOpen}
+              aria-controls={`${id}-list`}
+              aria-activedescendant={activeOptionId}
+              aria-autocomplete="list"
+              autoComplete="off"
+              spellCheck={false}
+              placeholder={t('workspace.catalog.search', 'Search workspaces')}
+              value={query}
+              onChange={(event) => { setQuery(event.target.value); setHighlightedId(undefined) }}
+              onKeyDown={onSearchKeyDown}
+              className="placeholder:text-muted-foreground focus-visible:ring-ring h-8 min-w-0 flex-1 rounded-sm bg-transparent px-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
+            />
+            {query && <Button type="button" size="icon" variant="ghost" aria-label={t('workspace.switcher.clearSearch', 'Clear search')} onClick={clearSearch}><X aria-hidden="true" /></Button>}
+          </div>
+          <div id={`${id}-list`} role="listbox" aria-label={t('workspace.switcher.label', 'Workspace')} className="min-h-0 overflow-y-auto overscroll-contain p-1">
+            {rows.map((workspace) => {
+              const isCurrent = workspace.id === config.workspaceId
+              const isFavorite = favorites.includes(workspace.id)
+              return <div
+                key={workspace.id}
+                id={`${id}-option-${encodeURIComponent(workspace.id)}`}
+                role="option"
+                aria-selected={workspace.id === activeId}
+                aria-current={isCurrent ? 'true' : undefined}
+                tabIndex={-1}
+                onPointerMove={(event) => { if (event.pointerType !== 'touch') setHighlightedId(workspace.id) }}
+                onMouseDown={(event) => event.preventDefault()}
+                onClick={() => choose(workspace.id)}
+                className="aria-selected:bg-accent aria-selected:text-accent-foreground flex cursor-pointer items-start gap-2 rounded-sm px-2 py-2.5 text-sm select-none"
+              >
+                <span className="mt-0.5 size-4 shrink-0">{isCurrent && <Check className="size-4" aria-hidden="true" />}</span>
+                <div className="min-w-0 flex-1">
+                  <div className="flex min-w-0 items-center gap-1.5">
+                    <span className="truncate font-medium" title={workspace.displayName || workspace.id}>{workspace.displayName || workspace.id}</span>
+                    {isFavorite && <><Star className="size-3 shrink-0 fill-amber-400 text-amber-600 dark:text-amber-400" aria-hidden="true" /><span className="sr-only">{t('workspace.switcher.favorite', 'Favorite')}</span></>}
+                    {isCurrent && <span className="text-muted-foreground shrink-0 text-[11px]">{t('workspace.catalog.current', 'Current')}</span>}
+                  </div>
+                  {workspace.displayName && workspace.displayName !== workspace.id && <p className="text-muted-foreground truncate text-xs" title={workspace.id}>{workspace.id}</p>}
+                  {Boolean(workspace.tags?.length) && <p className="text-muted-foreground truncate text-xs" title={workspace.tags?.join(', ')}>{workspace.tags?.join(' · ')}</p>}
+                  {workspace.readOnly && <span className="text-muted-foreground text-[11px]">{t('workspace.switcher.readOnly', 'read only')}</span>}
+                </div>
+                <span className="text-muted-foreground mt-0.5 flex shrink-0 items-center gap-1 text-xs tabular-nums" aria-label={t('workspace.catalog.documents', { defaultValue: '{{count}} documents', count: workspace.documents })}><FileText className="size-3" aria-hidden="true" />{workspace.documents.toLocaleString()}</span>
+              </div>
+            })}
+          </div>
+          {rows.length === 0 && <p role="status" className="text-muted-foreground px-4 py-6 text-center text-sm">{query.trim() ? t('workspace.catalog.noResults', 'No workspaces match your search.') : t('workspace.switcher.empty', 'No workspaces are available.')}</p>}
+          <div className="flex shrink-0 items-center justify-between gap-2 border-t px-3 py-2">
+            <p role="status" className="text-muted-foreground text-xs">{catalog.refreshing ? t('workspace.switcher.refreshing', 'Refreshing workspaces…') : catalog.stale ? t('workspace.catalog.stale', 'Showing the last available list. Refresh to check for changes.') : ''}</p>
+            <Button type="button" size="icon" variant="ghost" aria-label={t('workspace.catalog.refresh', 'Refresh workspaces')} disabled={catalog.refreshing} onClick={() => { void catalog.refresh() }}><RefreshCw aria-hidden="true" /></Button>
+          </div>
+        </PopoverContent>
+      </Popover>
+      <span className="hidden xl:inline-flex"><WorkspaceState workspace={current} /></span>
+      <Button size="icon" variant="ghost" tooltip={t('workspace.catalog.title', 'Your workspaces')} aria-label={t('workspace.catalog.title', 'Your workspaces')} onClick={() => setCatalogOpen(true)}><Search /></Button>
+      <WorkspaceCatalog open={catalogOpen} onOpenChange={setCatalogOpen} {...catalog} currentId={config.workspaceId} select={changeWorkspace} />
+    </div>
+  )
+}
