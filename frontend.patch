+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test'
+import { cleanup, fireEvent, screen, waitFor, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { renderWithProviders } from '@/test/render'
+import { WORKSPACE_FAVORITES_KEY } from '@/lib/workspaceCatalog'
+import WorkspaceSelector from './WorkspaceSelector'
+import WorkspaceReadOnlyNotice from './WorkspaceReadOnlyNotice'
+import type { RuntimeWorkspace } from '@/lib/runtimeConfig'
+
+const originalConfig = window.__LIGHTRAG_CONFIG__
+const originalUrl = window.location.href
+const workspaces: RuntimeWorkspace[] = [
+  { id: 'default', displayName: 'Main library', documents: 24, processed: 22, failed: 2, pending: 0, processing: 0, readOnly: false },
+  { id: 'meeting-notes', displayName: 'Meeting notes', tags: ['marine', 'Blue'], documents: 221, processed: 0, failed: 0, pending: 220, processing: 1, readOnly: true },
+  { id: 'Research.Team_v2', displayName: 'Ocean notes', tags: ['reference'], documents: 8, processed: 8, failed: 0, pending: 0, processing: 0, readOnly: false },
+  { id: 'research.team_v2', displayName: 'Archive notes', tags: ['history'], documents: 6, processed: 6, failed: 0, pending: 0, processing: 0, readOnly: false }
+]
+let assign: ReturnType<typeof spyOn<typeof window.location, 'assign'>>
+let fetchSpy: ReturnType<typeof spyOn<typeof globalThis, 'fetch'>>
+let rows: RuntimeWorkspace[]
+const json = () => new Response(JSON.stringify({ workspaces: rows }), { headers: { 'Content-Type': 'application/json' } })
+
+beforeEach(() => {
+  rows = workspaces.map((row) => ({ ...row }))
+  window.__LIGHTRAG_CONFIG__ = { workspaceId: 'default', defaultWorkspace: 'default', legacyStorageWorkspace: 'meeting-notes', workspaces: rows }
+  window.history.replaceState(null, '', '/workspaces/default/webui/')
+  localStorage.removeItem(WORKSPACE_FAVORITES_KEY)
+  assign = spyOn(window.location, 'assign').mockImplementation(() => {})
+  assign.mockClear()
+  fetchSpy = spyOn(globalThis, 'fetch').mockImplementation((async () => json()) as unknown as typeof fetch)
+  fetchSpy.mockClear()
+})
+afterEach(() => {
+  cleanup()
+  assign.mockRestore(); fetchSpy.mockRestore()
+  localStorage.removeItem(WORKSPACE_FAVORITES_KEY)
+  window.__LIGHTRAG_CONFIG__ = originalConfig
+  window.history.replaceState(null, '', originalUrl)
+})
+async function openPicker() {
+  const user = userEvent.setup()
+  renderWithProviders(<WorkspaceSelector />)
+  await user.click(screen.getByRole('button', { name: 'Workspace' }))
+  const search = screen.getByRole('combobox', { name: 'Search workspaces' })
+  await waitFor(() => expect(document.activeElement === search).toBe(true))
+  return { user, search }
+}
+function activeText(input: HTMLElement) {
+  return document.getElementById(input.getAttribute('aria-activedescendant') || '')?.textContent || ''
+}
+
+describe('searchable workspace picker', () => {
+  test('opens a labelled combobox with focus, current selection, counts and selectable read-only corpus', async () => {
+    const { search } = await openPicker()
+    expect(screen.getByRole('button', { name: 'Workspace' })).toHaveAccessibleDescription('Main library (24)')
+    expect(search).toHaveAttribute('aria-expanded', 'true')
+    expect(search.getAttribute('aria-controls')).toBe(screen.getByRole('listbox', { name: 'Workspace' }).id)
+    expect(screen.getByRole('option', { name: /Main library/ })).toHaveAttribute('aria-current', 'true')
+    expect(activeText(search)).toContain('Main library')
+    const readOnly = screen.getByRole('option', { name: /Meeting notes/ })
+    expect(readOnly).toHaveTextContent('read only')
+    expect(readOnly).not.toHaveAttribute('aria-disabled', 'true')
+    expect(within(readOnly).getByLabelText('221 documents')).toBeInTheDocument()
+    expect(document.querySelectorAll('select')).toHaveLength(0)
+  })
+  test('searches display names, exact IDs and tags without case sensitivity', async () => {
+    const { user, search } = await openPicker()
+    for (const term of ['MEETING NOTES', 'meeting-NOTES', 'MARINE blue']) {
+      await user.clear(search); await user.type(search, term)
+      expect(screen.getAllByRole('option')).toHaveLength(1)
