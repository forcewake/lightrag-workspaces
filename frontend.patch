+import { afterEach, describe, expect, test } from 'bun:test'
+import { cleanup, screen } from '@testing-library/react'
+import { renderWithProviders } from '@/test/render'
+import type { LightragStatus } from '@/api/lightrag'
+import StatusCard from './StatusCard'
+
+const originalConfig = window.__LIGHTRAG_CONFIG__
+const status = {
+  input_directory: '/data/inputs/meeting-notes',
+  configuration: {
+    workspace: '',
+    force_llm_summary_on_merge: 8,
+    kv_storage: 'JsonKVStorage',
+    doc_status_storage: 'JsonDocStatusStorage',
+    vector_storage: 'NanoVectorDBStorage',
+    graph_storage: 'NetworkXStorage'
+  }
+} as unknown as LightragStatus
+
+afterEach(() => {
+  cleanup()
+  window.__LIGHTRAG_CONFIG__ = originalConfig
+})
+
+describe('gateway workspace identity in status', () => {
+  test('shows the canonical corpus while explaining that storage namespaces are unchanged', () => {
+    window.__LIGHTRAG_CONFIG__ = {
+      workspaceId: 'meeting-notes',
+      workspaces: [{ id: 'meeting-notes', documents: 1, processed: 1, failed: 0, pending: 0, processing: 0, readOnly: false }]
+    }
+    renderWithProviders(<StatusCard status={status} />)
+    expect(screen.getAllByRole('cell', { name: 'meeting-notes' })).toHaveLength(4)
+    expect(screen.getByText(/Saved storage namespaces are unchanged/)).toBeInTheDocument()
+    expect(status.configuration.workspace).toBe('')
+  })
+
+  test('retains backend-reported storage workspace names outside the gateway', () => {
+    window.__LIGHTRAG_CONFIG__ = {}
+    renderWithProviders(<StatusCard status={{ ...status, configuration: { ...status.configuration, workspace: 'original_namespace' } }} />)
+    expect(screen.getAllByRole('cell', { name: 'original_namespace' })).toHaveLength(4)
+    expect(screen.queryAllByText(/Saved storage namespaces are unchanged/)).toHaveLength(0)
+  })
+})
