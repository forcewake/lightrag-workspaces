+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test'
+import { createWorkspace, getWorkspaceCatalog, getWorkspaceOperation, WorkspaceManagementError } from './workspaces'
+import { cleanup } from '@testing-library/react'
+import { useSettingsStore } from '@/stores/settings'
+
+let fetchSpy: ReturnType<typeof spyOn<typeof globalThis, 'fetch'>> | undefined
+const originalKey = useSettingsStore.getState().apiKey
+const originalToken = localStorage.getItem('LIGHTRAG-API-TOKEN')
+const originalConfig = window.__LIGHTRAG_CONFIG__
+// Other files mount shared headers; unmount before installing a process-wide fetch spy.
+beforeEach(() => { cleanup() })
+afterEach(() => {
+  cleanup()
+  fetchSpy?.mockRestore(); fetchSpy = undefined
+  useSettingsStore.setState({ apiKey: originalKey })
+  if (originalToken === null) localStorage.removeItem('LIGHTRAG-API-TOKEN'); else localStorage.setItem('LIGHTRAG-API-TOKEN', originalToken)
+  window.__LIGHTRAG_CONFIG__ = originalConfig
+})
+function response(body: unknown, status = 200) { return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } }) }
+const body = { id: 'Notes_2026.v1', displayName: 'Notes', description: '', tags: [] }
+describe('gateway workspace API', () => {
+  test('discovery stays at gateway root with credentials and never wakes a scoped worker', async () => {
+    window.__LIGHTRAG_CONFIG__ = { apiPrefix: '/workspaces/research' }
+    useSettingsStore.setState({ apiKey: 'test-key' })
+    localStorage.setItem('LIGHTRAG-API-TOKEN', 'test-session-token')
+    fetchSpy = spyOn(globalThis, 'fetch').mockImplementation((async (url: RequestInfo | URL, init?: RequestInit) => {
+      expect(url).toBe('/workspaces')
+      expect(init?.method).toBe('GET')
+      expect(init?.cache).toBe('no-store')
+      expect(init?.credentials).toBe('same-origin')
+      expect(init?.headers).toMatchObject({ 'X-API-Key': 'test-key', Authorization: 'Bearer test-session-token' })
+      expect(init?.body).toBeUndefined()
+      return response({ workspaces: [], capabilities: {} })
+    }) as typeof fetch)
+    await getWorkspaceCatalog()
+    expect(fetchSpy).toHaveBeenCalledTimes(1)
+  })
+  test('create sends exactly one mutation with the original idempotency key and exact ID', async () => {
+    fetchSpy = spyOn(globalThis, 'fetch').mockImplementation((async (url: RequestInfo | URL, init?: RequestInit) => {
+      expect(url).toBe('/workspaces')
+      expect(init?.method).toBe('POST')
+      expect(init?.headers).toMatchObject({ 'Idempotency-Key': 'test-key-1234567890' })
+      expect(JSON.parse(String(init?.body))).toEqual(body)
+      return response({ id: 'op-1', workspaceId: body.id, state: 'pending' }, 202)
+    }) as typeof fetch)
+    expect(await createWorkspace(body, 'test-key-1234567890')).toMatchObject({ state: 'pending', workspaceId: body.id })
+    expect(fetchSpy).toHaveBeenCalledTimes(1)
+  })
+  test('network failure is uncertain and never automatically repeats a creation', async () => {
+    fetchSpy = spyOn(globalThis, 'fetch').mockRejectedValue(new TypeError('offline'))
+    try { await createWorkspace(body, 'test-key-1234567890'); throw new Error('expected failure') }
+    catch (error) {
+      expect(error).toBeInstanceOf(WorkspaceManagementError)
+      expect(error).toMatchObject({ uncertain: true, retryable: true, code: 'connection' })
+    }
+    expect(fetchSpy).toHaveBeenCalledTimes(1)
+  })
+  test('safe operation error classification does not expose a response body', async () => {
+    fetchSpy = spyOn(globalThis, 'fetch').mockResolvedValue(response({ detail: { code: 'maintenance_active', retryable: true, message: 'private internals' } }, 503))
+    await expect(getWorkspaceOperation('op-1', body.id)).rejects.toMatchObject({ code: 'maintenance_active', retryable: true, message: 'maintenance_active', uncertain: false })
+  })
+  test('an operation for a different workspace cannot complete this request', async () => {
+    fetchSpy = spyOn(globalThis, 'fetch').mockResolvedValue(response({ id: 'op-1', workspaceId: 'different', state: 'succeeded' }))
+    await expect(getWorkspaceOperation('op-1', body.id)).rejects.toMatchObject({ code: 'invalid_response' })
+  })
+})
