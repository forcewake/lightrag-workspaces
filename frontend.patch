+++ b/lightrag_webui/src/components/WorkspaceIssue.tsx
@@ -0,0 +1,18 @@
+import { useTranslation } from 'react-i18next'
+
+const reasons: Record<string, string> = {
+  workspace_start_timeout: 'timeout', workspace_memory_unavailable: 'memory', workspace_capacity_busy: 'capacity',
+  workspace_process_exited: 'process', workspace_start_failed: 'process', workspace_spawn_failed: 'process',
+  database_unavailable: 'database', workspace_registration_invalid: 'registration', database_identity_mismatch: 'registration',
+  database_schema_not_ready: 'schema', database_migration_busy: 'maintenance', maintenance_active: 'maintenance', gateway_closing: 'maintenance',
+  authentication_required: 'authentication', authentication_unavailable: 'authentication', workspace_exists: 'exists',
+  invalid_workspace_id: 'invalidId', invalid_metadata: 'invalidMetadata', operation_interrupted: 'interrupted'
+}
+/** Only vetted messages are rendered; server logs, exception strings and URLs stay out of the UI. */
+export default function WorkspaceIssue({ code, retryable, retryAfterSeconds }: { code?: string | null; retryable?: boolean; retryAfterSeconds?: number | null }) {
+  const { t } = useTranslation()
+  const reason = code ? reasons[code] : undefined
+  return <span>{t(reason ? `workspace.catalog.reasons.${reason}` : retryable ? 'workspace.catalog.failedRetryable' : 'workspace.catalog.failedNeedsAttention')}
+    {retryable && retryAfterSeconds && retryAfterSeconds > 0 ? ` ${t('workspace.catalog.retryAfter', { count: Math.ceil(retryAfterSeconds) })}` : ''}
+  </span>
+}
