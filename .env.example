# Copy to .env. This file contains no credentials or production configuration.
# For an existing corpus, keep its EXACT embedding model and dimensions.

# Host exposure: trusted local access only by default.
BIND_ADDRESS=127.0.0.1
LIGHTRAG_PORT=9621
LIGHTRAG_MEMORY_LIMIT=8g

# Exact directory names under data/rag_storage; initialized explicitly.
LIGHTRAG_STORAGE_BACKEND=file
LIGHTRAG_DEFAULT_WORKSPACE=default
LIGHTRAG_MAX_ACTIVE_WORKSPACES=2
LIGHTRAG_WORKSPACE_STARTUP_TIMEOUT=240
LIGHTRAG_WORKSPACE_IDLE_SECONDS=600
LIGHTRAG_WORKSPACE_MEMORY_HEADROOM_BYTES=2147483648

# Choose your LightRAG-supported provider. The settings below are placeholders
# for OpenAI-compatible endpoints, including self-hosted compatible servers.
LLM_BINDING=openai
LLM_BINDING_HOST=https://llm.example.com/v1
LLM_BINDING_API_KEY=replace-with-your-llm-key
LLM_MODEL=replace-with-your-chat-model
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://embedding.example.com/v1
EMBEDDING_BINDING_API_KEY=replace-with-your-embedding-key
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_DIM=768
EMBEDDING_TOKEN_LIMIT=8192

# Global budgets are divided across the active workspace limit. Each budget
# must be at least LIGHTRAG_MAX_ACTIVE_WORKSPACES. No provider is contacted by
# discovery, initialization or the healthcheck.
MAX_ASYNC_LLM=8
EMBEDDING_FUNC_MAX_ASYNC=4
MAX_ASYNC_RERANK=4
MAX_PARALLEL_INSERT=2
RERANK_BINDING=null

# Native + legacy file processing; require credentials above before uploading.
LIGHTRAG_PARSER=*:native-teP,*:legacy-R
CHUNK_P_SIZE=2000
CHUNK_P_OVERLAP_SIZE=100

# Optional shared authentication. Never expose a no-auth deployment to untrusted
# networks. These settings apply across all workspaces, with no per-workspace ACL.
# LIGHTRAG_API_KEY=replace-with-a-long-random-shared-key
# AUTH_ACCOUNTS=admin:replace-with-a-long-random-password
# TOKEN_SECRET=replace-with-a-long-random-signing-secret

# Optional PostgreSQL + VectorChord backend. Start with a NEW dedicated empty
# database and use the explicit migration guide before changing backend to
# postgres. Existing file corpora are never imported by startup or discovery.
# Keep source data/backups separate from the new PostgreSQL control root.
# POSTGRES_HOST=postgresql
# POSTGRES_PORT=5432
# POSTGRES_USER=lightrag
# POSTGRES_PASSWORD=replace-with-a-private-database-password
# POSTGRES_DATABASE=lightrag_workspaces
# POSTGRES_SSL_MODE=disable
# POSTGRES_MAX_CONNECTIONS=4
# POSTGRES_VECTOR_INDEX_TYPE=VCHORDRQ
# POSTGRES_VCHORDRQ_EPSILON=2.3
# POSTGRES_VCHORDRQ_PROBES=
# POSTGRES_VCHORDRQ_BUILD_OPTIONS=
